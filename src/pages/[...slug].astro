---
import { getCollection, render } from "astro:content";
import "../styles/global.css";
import Post from "../layouts/Post.astro";

export async function getStaticPaths() {
    const regex = /^(\d{4})-(\d{2})-(\d{2})-(.+)/;

    const posts = await getCollection('blog');
    return posts.filter(entry => {
        return regex.test(entry.id) // Supress wrong entries
    }).map(post => {
        const pathParts = regex.exec(post.id);
        const slug = pathParts?.slice(1,5).join("/");
        
        return {
            params: { slug },
            props: { post },
        }
    });
}

console.log(Astro.params.slug);

const { post } = Astro.props;
const { Content, headings } = await render(post);
---


<Post
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    updateDate={post.data.updateDate}
    headings={headings}
    slug={`${Astro.site}${Astro.params.slug}`}
    postId={Astro.props.post.id}
    >
        <Content />
</Post>