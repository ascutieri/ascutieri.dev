---
import { getCollection } from "astro:content";
import { generateTextFromDate } from "../utils";
import Home from "../layouts/Home.astro";

const posts = await getCollection('blog');

const groupMap = new Map();
for (const post of posts) {
	const pubDate = post.data.pubDate;

	const key = `${pubDate.getFullYear()}-${pubDate.getMonth()}`;

	if (groupMap.has(key)) {
		groupMap.set(key, groupMap.get(key).add(post));
	} else {
		const dateSet = new Set();
		dateSet.add(post);
		groupMap.set(key, dateSet);
	}
}

const sortedMap = new Map([...groupMap].sort().reverse().slice(0,12));

const headings = [...sortedMap.keys()].map(item => {
	return {
		depth: 2,
		slug: item,
		text: generateTextFromDate(item),
	}
});

console.log(new Date('2026-0'));
---

<Home content={sortedMap} headings={headings} />


