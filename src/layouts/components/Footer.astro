---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--ctp-crust)] text-[var(--ctp-subtext)] border-t border-[var(--ctp-surface)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
      <div>
        <h3 class="font-bold text-[var(--ctp-text)] mb-2">Andre Scutieri</h3>
        <p class="text-sm">Web developer e entusiasta de tecnologia.</p>
      </div>
      
      <div class="flex gap-8">
        <div>
          <h4 class="font-semibold text-[var(--ctp-text)] mb-3">Links</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/" class="hover:text-[var(--ctp-text)] transition-colors">Home</a></li>
            <li><a href="/sobre" class="hover:text-[var(--ctp-text)] transition-colors">Sobre</a></li>
            <li><a href="/blog" class="hover:text-[var(--ctp-text)] transition-colors">Blog</a></li>
          </ul>
        </div>
        
        <div>
          <h4 class="font-semibold text-[var(--ctp-text)] mb-3">Social</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="#" class="hover:text-[var(--ctp-text)] transition-colors">GitHub</a></li>
            <li><a href="#" class="hover:text-[var(--ctp-text)] transition-colors">LinkedIn</a></li>
            <li><a href="#" class="hover:text-[var(--ctp-text)] transition-colors">Twitter</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-[var(--ctp-surface)] mt-8 pt-8">
      <p class="text-sm text-center text-[var(--ctp-subtext)]/70">
        &copy; {currentYear} Andre Scutieri. Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>
