---
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/" && currentPath === "/") return true;
  if (href !== "/" && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="sticky top-0 z-50 backdrop-blur-sm bg-[var(--ctp-mantle)]/95 border-b border-[var(--ctp-surface)]">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center space-x-3 group">
      <span class="font-bold text-lg text-[var(--ctp-text)] hidden sm:inline">Andre <span class="text-[var(--ctp-accent)]">Scutieri</span></span>
    </a>

    <!-- Navigation + Theme Toggle -->
    <div class="flex items-center space-x-8">
      <a
        href="/"
        class={`transition-colors ${
          isActive("/")
            ? "text-[var(--ctp-text)] font-semibold"
            : "text-[var(--ctp-subtext)] hover:text-[var(--ctp-text)]"
        }`}
      >
        home
      </a>
      <a
        href="/sobre"
        class={`transition-colors ${
          isActive("/sobre")
            ? "text-[var(--ctp-text)] font-semibold"
            : "text-[var(--ctp-subtext)] hover:text-[var(--ctp-text)]"
        }`}
      >
        sobre
      </a>
      <a
        href="/blog"
        class={`transition-colors ${
          isActive("/blog")
            ? "text-[var(--ctp-text)] font-semibold"
            : "text-[var(--ctp-subtext)] hover:text-[var(--ctp-text)]"
        }`}
      >
        blog
      </a>

      <div class="w-px h-6 bg-[var(--ctp-surface)]"></div>

      <ThemeToggle />
    </div>
  </nav>
</header>
