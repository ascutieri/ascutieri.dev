---
import "../styles/global.css";
import Header from "./components/Header.astro";
import Footer from "./components/Footer.astro";
import Sidebar from "./components/Sidebar.astro";
import BackToTop from "./components/BackToTop.astro";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updateDate?: Date;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, pubDate, updateDate, headings = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("pt-BR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const formattedUpdateDate = updateDate?.toLocaleDateString("pt-BR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Andre Scutieri</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-[var(--ctp-base)] text-[var(--ctp-text)]">
    <Header />

    <main class="min-h-screen pt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-5 gap-8">
        <!-- Main content area -->
        <article class="lg:col-span-4">
          <!-- Article header -->
          <div class="mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-[var(--ctp-text)] mb-4">
              {title}
            </h1>

            <!-- Metadata -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:space-x-4 text-sm text-[var(--ctp-subtext)]">
              <time datetime={pubDate.toISOString()}>
                {formattedDate}
              </time>

              {updateDate && (
                <span class="hidden sm:inline text-[var(--ctp-surface)]">•</span>
              )}

              {updateDate && (
                <time datetime={updateDate.toISOString()} class="text-[var(--ctp-subtext)]">
                  Atualizado em {formattedUpdateDate}
                </time>
              )}

              <span class="hidden sm:inline text-[var(--ctp-surface)]">•</span>

              <a
                href="#comments"
                class="text-[var(--ctp-accent)] hover:text-[var(--ctp-accent)]/80 transition-colors font-medium"
              >
                Deixe um comentário
              </a>
            </div>
          </div>

          <!-- Article content with typography -->
          <div class="prose lg:prose-lg prose-slate max-w-none mb-20 prose-invert dark:prose-invert">
            <slot />
          </div>

          <!-- Comments section placeholder -->
          <section id="comments" class="border-t border-[var(--ctp-surface)] pt-12">
            <h2 class="text-2xl font-bold text-[var(--ctp-text)] mb-6">Comentários</h2>
            <div class="bg-[var(--ctp-surface)] rounded-lg p-8 text-center">
              <p class="text-[var(--ctp-subtext)]">
                Os comentários serão em breve integrados nesta página.
              </p>
            </div>
          </section>
        </article>

        <!-- Sidebar for TOC -->
        <Sidebar headings={headings} />
      </div>
    </main>

    <BackToTop />
    <Footer />

    <script>
      // Intercepta clicks em links internos e faz scroll com offset
      document.querySelectorAll('a[href^="#"]').forEach(link => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (href && href !== '#') {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) {
              const headerHeight = 96; // 6rem = 96px
              const targetPosition = target.getBoundingClientRect().top + window.scrollY - headerHeight;
              window.scrollTo({
                top: targetPosition,
                behavior: 'smooth'
              });
            }
          }
        });
      });
    </script>
  </body>
</html>
