---
import "../styles/global.css";
import BackToTop from "./components/BackToTop.astro";
import Header from "./components/Header.astro";
import Footer from "./components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description } = Astro.props;

const pageTitle = title ? `${title} | Andre Scutieri` : 'Andre Scutieri | Web Developer';
const pageDescription = title ? `${description}` :  "Andre Scutieri - Web developer e entusiasta de tecnologia";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <script src="https://kit.fontawesome.com/bd10b73b4a.js" crossorigin="anonymous"></script>
</head>
<body class="bg-[var(--ctp-base)] text-[var(--ctp-text)]">
    <Header />
    <main class="min-h-screen pt-12">
        <slot></slot>
    </main>
    <BackToTop />
    <Footer />

    <script>
      // Intercepta clicks em links internos e faz scroll com offset
      document.querySelectorAll('a[href^="#"]').forEach(link => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (href && href !== '#') {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) {
              const headerHeight = 96; // 6rem = 96px
              const targetPosition = target.getBoundingClientRect().top + window.scrollY - headerHeight;
              window.scrollTo({
                top: targetPosition,
                behavior: 'smooth'
              });
            }
          }
        });
      });
    </script>
</body>
</html>