---
import "../styles/global.css";
import Base from "./Base.astro";
import Sidebar from "./components/Sidebar.astro";
import MonthEntries from "./components/MonthEntries.astro";

interface Props {
  content?: any;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { content, headings = [] } = Astro.props;
---

<Base>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-5 gap-8">
    <!-- Main content area -->
    <article class="lg:col-span-4">
        <h1 class="text-5xl md:text-6xl font-bold text-[var(--ctp-text)] text-center mb-16">
            Recentes
        </h1>

        { content.keys().map((key: string) => (
            <MonthEntries id={key} items={content.get(key)} />
        )) }
    </article>

    <!-- Sidebar for TOC -->
    <Sidebar headings={headings} />
    </div>
</Base>