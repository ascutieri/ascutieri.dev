---
import "../styles/global.css";
import Header from "./components/Header.astro";
import Footer from "./components/Footer.astro";
import Sidebar from "./components/Sidebar.astro";
import BackToTop from "./components/BackToTop.astro";
import MonthEntries from "./components/MonthEntries.astro";

interface Props {
  content?: any;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { content, headings = [] } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Andre Scutieri | Web Developer</title>
    <meta name="description" content="Andre Scutieri - Web developer e entusiasta de tecnologia" />
  </head>
  <body class="bg-[var(--ctp-base)] text-[var(--ctp-text)]">
    <Header />

    <main class="min-h-screen pt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-5 gap-8">
        <!-- Main content area -->
        <article class="lg:col-span-4">
            { content.keys().map((key: string) => (
                <MonthEntries id={key} items={content.get(key)} />
            )) }
        </article>

        <!-- Sidebar for TOC -->
        <Sidebar headings={headings} />
      </div>
    </main>

    <BackToTop />
    <Footer />

    <script>
      // Intercepta clicks em links internos e faz scroll com offset
      document.querySelectorAll('a[href^="#"]').forEach(link => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (href && href !== '#') {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) {
              const headerHeight = 96; // 6rem = 96px
              const targetPosition = target.getBoundingClientRect().top + window.scrollY - headerHeight;
              window.scrollTo({
                top: targetPosition,
                behavior: 'smooth'
              });
            }
          }
        });
      });
    </script>
  </body>
</html>